component App {
    view {
        <div class="root col pad-0 gap-10 fill bg-none">
            <div class="row row pad-0 gap-10 bg-none">
                <div class="a w-120 h-80 pad-0"></div>
                <div class="b w-120 h-80 pad-0"></div>
                <div class="c w-120 h-80 pad-0"></div>
            </div>
            <div class="row row pad-0 gap-10 bg-none">
                <div class="d w-180 h-60 pad-0"></div>
                <div class="e w-60 h-60 pad-0"></div>
                <div class="f w-60 h-60 pad-0"></div>
            </div>
        </div>
    }
}

app {
    root = App;
}


component App {
    view {
        <div class="root pad-0 gap-0 fill bg-none">
            <div class="scroller w-60 h-20 pad-0 gap-0 scroll-y bg-none">
                <div class="a w-60 h-10 pad-0"></div>
                <div class="b w-60 h-10 pad-0"></div>
                <div class="c w-60 h-10 pad-0"></div>
                <div class="d w-60 h-10 pad-0"></div>
            </div>
        </div>
    }
}

app {
    root = App;
}


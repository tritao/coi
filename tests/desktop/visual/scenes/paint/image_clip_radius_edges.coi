component App {
  view {
    <div class="col gap-24 pad-24">
      <div class="row gap-24">
        <div class="col gap-12 pad-16 border-4 r-18 w-420 h-320">
          <div>Clipped (rounded corners should cut image)</div>
          <div class="clip border-10 r-48 w-320 h-220">
            <img src="tests/desktop/visual/assets/solid_green_128.tga" class="w-320 h-220" />
          </div>
        </div>

        <div class="col gap-12 pad-16 border-4 r-18 w-420 h-320">
          <div>Not clipped (image should stay square)</div>
          <div class="border-10 r-48 w-320 h-220">
            <img src="tests/desktop/visual/assets/solid_green_128.tga" class="w-320 h-220" />
          </div>
        </div>
      </div>
    </div>
  }
}

app {
  root = App;
}

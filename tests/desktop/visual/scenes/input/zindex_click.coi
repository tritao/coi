component App {
  mut int a = 0;
  mut int b = 0;
  mut int state = 0;

  def clickA() : void {
    a += 1;
    state = 1;
  }

  def clickB() : void {
    b += 1;
    state = 2;
  }

  view {
    <div class="root fill bg-none">
      <div class="status float-parent fx-24 fy-24 z-30 pad-12 border-4 r-12" >
        clicks: A={a} B={b}
      </div>

      <div class="a float-parent fx-80 fy-80 z-10 w-420 h-220 pad-0 border-10 r-32" onclick={clickA}>
        <div class="pad-16">A (z-10)</div>
      </div>

      <div class="b float-parent fx-160 fy-140 z-20 w-420 h-220 pad-0 border-10 r-32" onclick={clickB}>
        <div class="pad-16">B (z-20) should win</div>
        <div class="w-420 h-160 pad-0">
          <if state == 2>
            <img src="tests/desktop/visual/assets/solid_green_128.tga" class="w-420 h-160" />
          <else>
            <div class="w-420 h-160 pad-0 bg-none"></div>
          </else>
          </if>
        </div>
      </div>
    </div>
  }
}

app {
  root = App;
}

component App {
    view {
        <div class="root col pad-20 gap-20 fill bg-none">
            <div class="row row pad-0 gap-20 bg-none">
                <div class="b0 w-200 h-200 pad-0 border-none"></div>
                <div class="b1 w-200 h-200 pad-0 border"></div>
                <div class="b2 w-200 h-200 pad-0 border-2"></div>
                <div class="b6 w-200 h-200 pad-0 border-6"></div>
            </div>
            <div class="row row pad-0 gap-20 bg-none">
                <div class="c10 w-300 h-240 pad-0 border-10"></div>
                <div class="c2 grow h-240 pad-0 border-2"></div>
            </div>
        </div>
    }
}

app {
    root = App;
}
